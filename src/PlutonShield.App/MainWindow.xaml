<Window
    x:Class="PlutonShield.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PlutonShield.App">

    <Grid>
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="250"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem loc:L.Key="nav.home" Tag="home" Icon="Home" />
                <NavigationViewItem loc:L.Key="nav.filters" Tag="filters" Icon="Filter" />
                <NavigationViewItem loc:L.Key="nav.lists" Tag="lists" Icon="List" />
                <NavigationViewItem loc:L.Key="nav.apps" Tag="apps" Icon="AllApps" />
                <NavigationViewItem loc:L.Key="nav.custom" Tag="custom" Icon="Edit" />
                <NavigationViewItem loc:L.Key="nav.stats" Tag="stats" Icon="Calendar" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- The bell: shown only while a newer version of the app exists (see RefreshUpdateItem). The icon is drawn
                     as a path (a bell, 24 x 24) so that it does not depend on a symbol font. -->
                <NavigationViewItem x:Name="UpdateNavItem" loc:L.Key="nav.update" Tag="update" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M12 22 c1.1 0 2 -0.9 2 -2 h-4 c0 1.1 0.89 2 2 2 z m6 -6 v-5 c0 -3.07 -1.63 -5.64 -4.5 -6.32 V4 c0 -0.83 -0.67 -1.5 -1.5 -1.5 s-1.5 0.67 -1.5 1.5 v0.68 C7.64 5.36 6 7.92 6 11 v5 l-2 2 v1 h16 v-1 l-2 -2 z m-2 1 H8 v-6 c0 -2.48 1.51 -4.5 4 -4.5 s4 2.02 4 4.5 v6 z" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem loc:L.Key="nav.settings" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <!-- 32 = height of the caption buttons: the page starts below them. -->
            <Frame x:Name="ContentFrame" Margin="0,32,0,0" />
        </NavigationView>

        <!-- Only a strip to drag the window by. The menu button on the left (48) stays clickable; the minimize, maximize
             and close buttons are drawn by Windows on the right. -->
        <Grid x:Name="TitleBarDragRegion"
              Height="32"
              Margin="48,0,0,0"
              VerticalAlignment="Top"
              Background="Transparent" />
    </Grid>
</Window>
