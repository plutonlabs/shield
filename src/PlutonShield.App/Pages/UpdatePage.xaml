<Page
    x:Class="PlutonShield.App.Pages.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PlutonShield.App"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock loc:L.Key="update.title" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock x:Name="Headline" loc:L.Key="nav.update" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="VersionsText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel x:Name="NotesPanel" Spacing="8">
                <TextBlock loc:L.Key="update.notes" FontWeight="SemiBold" />
                <Border Padding="12" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />

            <StackPanel x:Name="Buttons" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UpdateButton" loc:L.Key="update.now" Style="{StaticResource AccentButtonStyle}" Click="UpdateNow_Click" />
                <Button loc:L.Key="update.later" Click="Later_Click" />
                <HyperlinkButton loc:L.Key="update.github" Click="ViewOnGitHub_Click" />
            </StackPanel>
            <TextBlock x:Name="HintText" loc:L.Key="update.hint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
