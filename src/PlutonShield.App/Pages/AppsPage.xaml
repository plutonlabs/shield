<Page
    x:Class="PlutonShield.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PlutonShield.App"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock loc:L.Key="apps.title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock loc:L.Key="apps.intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock loc:L.Key="apps.note" Style="{StaticResource SecondaryText}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddButton" loc:L.Key="apps.add" Click="Add_Click" />
                <Button x:Name="ResetButton" loc:L.Key="apps.reset" Click="Reset_Click" />
            </StackPanel>

            <TextBlock x:Name="EmptyText" loc:L.Key="apps.empty" Style="{StaticResource SecondaryText}" Visibility="Collapsed" />

            <Border Padding="16,8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel x:Name="Rows" Spacing="0" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
