<Page
    x:Class="PlutonShield.App.Pages.FilterListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PlutonShield.App"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock loc:L.Key="lists.title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock loc:L.Key="lists.intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="AdultToggle" loc:L.Header="adult.title" Toggled="AdultToggle_Toggled" />
                    <TextBlock loc:L.Key="adult.intro" Style="{StaticResource SecondaryText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="AdultRing" IsActive="False" Width="16" Height="16" />
                        <TextBlock x:Name="AdultStatus" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="AdultRetry" loc:L.Key="adult.retry" Click="AdultRetry_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SafeSearchToggle" loc:L.Header="adult.safesearch" Toggled="SafeSearchToggle_Toggled" Margin="0,8,0,0" />
                    <TextBlock loc:L.Key="adult.safesearch.hint" Style="{StaticResource SecondaryText}" />
                    <InfoBar x:Name="AdultBar" IsOpen="False" IsClosable="False" Severity="Warning" />
                    <TextBlock loc:L.Key="adult.limits" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="RulesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="Ring" IsActive="False" Width="16" Height="16" />
                        <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <InfoBar x:Name="WarnBar" IsOpen="False" IsClosable="False" Severity="Warning" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="SearchBox" Width="360" TextChanged="SearchBox_TextChanged" />
                <Button loc:L.Key="lists.reset" Click="ResetAll_Click" />
            </StackPanel>

            <StackPanel x:Name="GroupsPanel" Spacing="8" />

            <TextBlock loc:L.Key="lists.custom.hint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
