<Page
    x:Class="PlutonShield.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PlutonShield.App"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Padding="40,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock loc:L.Key="settings.title" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- The version, and the two things people look for first: is there a newer one, and where is the project. -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="VersionText" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CheckButton" loc:L.Key="settings.update.check" Click="CheckUpdate_Click" />
                    <Button loc:L.Key="settings.github" Click="OpenGitHub_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="ViewUpdateButton" loc:L.Key="settings.update.view" Visibility="Collapsed" Click="ViewUpdate_Click" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="SavedText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock loc:L.Key="settings.general" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="LanguageBox" loc:L.Header="settings.language" Width="280" SelectionChanged="LanguageBox_SelectionChanged">
                <ComboBoxItem x:Name="LangAuto" loc:L.Key="settings.language.auto" Tag="" />
                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <ToggleSwitch x:Name="StartWithWindows" loc:L.Header="settings.startwithwindows" Toggled="Toggle_Toggled" />
            <ToggleSwitch x:Name="StartMinimized" loc:L.Header="settings.startminimized" Toggled="Toggle_Toggled" />
            <ToggleSwitch x:Name="AutoAppUpdate" loc:L.Header="settings.appautoupdate" Toggled="Toggle_Toggled" />
            <Button loc:L.Key="settings.restart" Click="Restart_Click" />
            <TextBlock loc:L.Key="settings.restart.hint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock loc:L.Key="settings.filters" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch x:Name="AutoUpdate" loc:L.Header="settings.autoupdate" Toggled="Toggle_Toggled" />
            <NumberBox x:Name="Interval" loc:L.Header="settings.interval" Minimum="1" Maximum="168"
                       SpinButtonPlacementMode="Inline" Width="220" HorizontalAlignment="Left" ValueChanged="Number_ValueChanged" />
            <ToggleSwitch x:Name="BlockPopups" loc:L.Header="settings.popups" Toggled="Toggle_Toggled" />
            <ToggleSwitch x:Name="Cosmetic" loc:L.Header="settings.cosmetic" Toggled="Toggle_Toggled" />

            <TextBlock loc:L.Key="settings.https" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch x:Name="FilterHttps" loc:L.Header="settings.filterhttps" Toggled="Toggle_Toggled" />
            <TextBox x:Name="Excluded" loc:L.Header="settings.excluded"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" LostFocus="Excluded_LostFocus" />

            <TextBlock loc:L.Key="settings.network" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <NumberBox x:Name="Port" loc:L.Header="settings.port" Minimum="1024" Maximum="65535"
                       SpinButtonPlacementMode="Hidden" Width="220" HorizontalAlignment="Left" ValueChanged="Number_ValueChanged" />

            <TextBlock loc:L.Key="settings.cert" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0" />
            <TextBlock x:Name="CertText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button loc:L.Key="settings.cert.install" Click="InstallCert_Click" />
                <Button loc:L.Key="settings.cert.remove" Click="RemoveCert_Click" />
                <Button loc:L.Key="settings.cert.folder" Click="OpenCertFolder_Click" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" loc:L.Key="settings.cert.firefox" />

            <TextBlock loc:L.Key="settings.trouble" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0" />
            <Button loc:L.Key="settings.resetproxy" Click="ResetProxy_Click" />
            <TextBlock x:Name="ResetText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button loc:L.Key="settings.diag.copy" Click="CopyDiag_Click" />
                <Button loc:L.Key="settings.diag.folder" Click="OpenLogFolder_Click" />
            </StackPanel>
            <TextBlock x:Name="DiagText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
